-- Validation Helpers
local function GetCharacterState()
	local char = LocalPlayer.Character
	if not char then return nil, nil, nil end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local root = char:FindFirstChild("HumanoidRootPart")
	return char, hum, root
end

local function IsPlayerValid(player)
	if not player or player == LocalPlayer then return false end
	if Whitelist[player.Name] or Whitelist[player.DisplayName] then return false end
	local char = player.Character
	if not char then return false end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local root = char:FindFirstChild("HumanoidRootPart")
	if not hum or not root or hum.Health <= 0 then return false end
	return true, char, hum, root
end

-- Teleport & Loop Controller
task.spawn(function()
	while getgenv().TrackerCoreExpanded do
		if not State.FarmActive then
			task.wait(Config.TickInterval)
			continue
		end
		
		local char, hum, root = GetCharacterState()
		if not char or not hum or hum.Health <= 0 or not root then
			task.wait(Config.TickInterval)
			continue
		end
		
		-- Check Void Safety
		if root.Position.Y < Config.VoidThreshold then
			root.CFrame = CFrame_new(root.Position.X, Config.SafeSpawnHeight, root.Position.Z)
			root.AssemblyLinearVelocity = Vector3_new(0, 0, 0)
		end
		
		-- Find Target
		local targetPlayer = nil
		if State.LockedTarget then
			local valid = IsPlayerValid(State.LockedTarget)
			if valid then targetPlayer = State.LockedTarget end
		else
			local lowestHealth = math_huge
			local maxDistSq = Config.MaxDistance * Config.MaxDistance
			for _, player in ipairs(Players:GetPlayers()) do
				local valid, _, pHum, pRoot = IsPlayerValid(player)
				if valid then
					local dx = pRoot.Position.X - root.Position.X
					local dy = pRoot.Position.Y - root.Position.Y
					local dz = pRoot.Position.Z - root.Position.Z
					local distSq = (dx * dx) + (dy * dy) + (dz * dz)
					if distSq <= maxDistSq and pHum.Health < lowestHealth then
						lowestHealth = pHum.Health
						targetPlayer = player
					end
				end
			end
		end
		
		if targetPlayer then
			local tValid, tChar, tHum, tRoot = IsPlayerValid(targetPlayer)
			if tValid then
				-- Teleport to target
				root.CFrame = tRoot.CFrame * CFrame_new(0, 3, 0)
				root.AssemblyLinearVelocity = Vector3_new(0, 0, 0)
				
				-- Follow target until dead
				while getgenv().TrackerCoreExpanded and State.FarmActive and tHum.Health > 0 do
					local curChar, curHum, curRoot = GetCharacterState()
					if not curHum or curHum.Health <= 0 or not curRoot then break end
					
					local targetRoot = targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart")
					if targetRoot then
						curRoot.CFrame = targetRoot.CFrame * CFrame_new(0, 3, 0)
						curRoot.AssemblyLinearVelocity = Vector3_new(0, 0, 0)
					end
					RunService.Heartbeat:Wait()
				end
				
				-- Suspension / Float after kill
				local killTime = tick()
				local suspPos = nil
				while getgenv().TrackerCoreExpanded and State.FarmActive and (tick() - killTime) < Config.SuspensionDuration do
					local curChar, curHum, curRoot = GetCharacterState()
					if not curHum or curHum.Health <= 0 then break end
					if curRoot then
						if not suspPos then
							suspPos = curRoot.Position + Vector3_new(0, Config.SuspensionHeight, 0)
						end
						curRoot.CFrame = CFrame_new(suspPos)
						curRoot.AssemblyLinearVelocity = Vector3_new(0, 0, 0)
					end
					RunService.Heartbeat:Wait()
				end
			end
		end
		
		task.wait(Config.TickInterval)
	end
end)
