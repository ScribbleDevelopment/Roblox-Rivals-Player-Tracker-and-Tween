-- Refresh Whitelist List UI
local function RefreshWhitelistUI()
	for _, child in ipairs(WhitelistScroll:GetChildren()) do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end
	
	local count = 0
	for name, _ in pairs(Whitelist) do
		count = count + 1
		local btn = Instance.new("TextButton")
		btn.Size = UDim2.new(1, -6, 0, 28)
		btn.BackgroundColor3 = Color3.fromRGB(50, 40, 75)
		btn.BackgroundTransparency = 0.3
		btn.TextColor3 = Color3.fromRGB(230, 220, 250)
		btn.Text = "  " .. name .. " (Click to Unignore)"
		btn.TextSize = 10
		btn.Font = Enum.Font.Gotham
		btn.TextXAlignment = Enum.TextXAlignment.Left
		btn.Parent = WhitelistScroll
		
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 6)
		corner.Parent = btn
		
		btn.MouseButton1Click:Connect(function()
			Whitelist[name] = nil
			RefreshWhitelistUI()
		end)
	end
	WhitelistScroll.CanvasSize = UDim2.new(0, 0, 0, count * 32)
end

