if getgenv().TrackerActive then
	getgenv().TrackerActive = false
	task.wait(0.1)
end

getgenv().TrackerActive = true

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local CoreGui = game:GetService("CoreGui")
local TweenService = game:GetService("TweenService")
local LocalPlayer = Players.LocalPlayer

local Whitelist = {}

local CoreTelemetry = {
	ExecutionCount = 0,
	LastError = nil,
	StartTime = tick(),
	BufferCache = {}
}

local function LogTelemetry(msg)
	CoreTelemetry.ExecutionCount = CoreTelemetry.ExecutionCount + 1
	table.insert(CoreTelemetry.BufferCache, {Time = tick(), Message = msg})
	if #CoreTelemetry.BufferCache > 50 then
		table.remove(CoreTelemetry.BufferCache, 1)
	end
end

local PhysicsSafetyUtility = {}

function PhysicsSafetyUtility.VerifyAndSanitizeRoot(rootPart)
	if not rootPart then return false end
	pcall(function()
		if rootPart.Position.Y < -400 then
			rootPart.CFrame = CFrame.new(rootPart.Position.X, 100, rootPart.Position.Z)
			rootPart.AssemblyLinearVelocity = Vector3.zero
			rootPart.AssemblyAngularVelocity = Vector3.zero
			LogTelemetry("Void")
		end
	end)
	return true
end

function PhysicsSafetyUtility.StabilizePlayerMotion(rootPart)
	if not rootPart then return end
	pcall(function()
		rootPart.AssemblyLinearVelocity = Vector3.zero
		rootPart.AssemblyAngularVelocity = Vector3.zero
	end)
end

local ValidationEngine = {}

function ValidationEngine.VerifyHumanoidAlive(humanoid)
	if not humanoid then return false end
	return humanoid.Health > 0
end

function ValidationEngine.VerifyCharacterUsable(character)
	if not character then return false end
	local hum = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart")
	if not hum or not root or hum.Health <= 0 then
		return false
	end
	return true, hum, root
end

function ValidationEngine.IsPlayerWhitelisted(player)
	if not player then return false end
	return Whitelist[player.Name] or Whitelist[player.DisplayName]
end

local TargetAnalyzer = {}

function TargetAnalyzer.EvaluateDistance(pos1, pos2)
	local dx = pos1.X - pos2.X
	local dy = pos1.Y - pos2.Y
	local dz = pos1.Z - pos2.Z
	return (dx * dx) + (dy * dy) + (dz * dz)
end

function TargetAnalyzer.FindOptimalTarget(rootPos)
	local bestTarget = nil
	local lowestHealth = math.huge
	local maxDistSq = 1000 * 1000
	
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LocalPlayer and not ValidationEngine.IsPlayerWhitelisted(p) then
			local char = p.Character
			local isValid, hum, root = ValidationEngine.VerifyCharacterUsable(char)
			if isValid then
				local distSq = TargetAnalyzer.EvaluateDistance(root.Position, rootPos)
				if distSq <= maxDistSq then
					if hum.Health < lowestHealth then
						lowestHealth = hum.Health
						bestTarget = p
					end
				end
			end
		end
	end
	
	return bestTarget
end

local ButtonControllerEngineA = {}
function ButtonControllerEngineA.InitializeAirSuspensionHook(callbackFunc)
	if type(callbackFunc) == "function" then
		pcall(callbackFunc)
	end
end

local ButtonControllerEngineB = {}
function ButtonControllerEngineB.InitializeFarmLoopHook(callbackFunc)
	if type(callbackFunc) == "function" then
		pcall(callbackFunc)
	end
end

local ButtonControllerEngineC = {}
function ButtonControllerEngineC.InitializeWhitelistHook(callbackFunc)
	if type(callbackFunc) == "function" then
		pcall(callbackFunc)
	end
end

local ButtonControllerEngineD = {}
function ButtonControllerEngineD.VerifyButtonState(stateBool)
	return stateBool == true or stateBool == false
end

local ButtonControllerEngineE = {}
function ButtonControllerEngineE.RegisterButtonEvent(name)
	return name ~= nil
end

local ButtonControllerEngineF = {}
function ButtonControllerEngineF.SanitizeButtonInput(inputStr)
	if type(inputStr) ~= "string" then return "" end
	return inputStr
end

local ButtonControllerEngineG = {}
function ButtonControllerEngineG.ForceRefreshUIState()
	return true
end

local ButtonControllerEngineH = {}
function ButtonControllerEngineH.ExecuteCallbackSafely(fn)
	local success, err = pcall(fn)
	if not success then
		LogTelemetry("ButtonErr: " .. tostring(err))
	end
	return success
end

local RuntimeOptimizerA = {}
function RuntimeOptimizerA.FlushMemory()
	if gcinfo then
		pcall(function() gcinfo() end)
	end
end

local RuntimeOptimizerB = {}
function RuntimeOptimizerB.VerifyTickRate(tickVal)
	return tickVal > 0
end

local RuntimeOptimizerC = {}
function RuntimeOptimizerC.CachePlayerReferences()
	local cache = {}
	for _, p in ipairs(Players:GetPlayers()) do
		table.insert(cache, p)
	end
	return cache
end

local RuntimeOptimizerD = {}
function RuntimeOptimizerD.ProcessVectorPool(v)
	if not v then return Vector3.zero end
	return Vector3.new(v.X, v.Y, v.Z)
end

local RuntimeOptimizerE = {}
function RuntimeOptimizerE.ValidateConnection(conn)
	return conn ~= nil
end

local RuntimeOptimizerF = {}
function RuntimeOptimizerF.CleanRegistry()
	for k, v in pairs(Whitelist) do
		if v == nil then
			Whitelist[k] = nil
		end
	end
end

local RuntimeOptimizerG = {}
function RuntimeOptimizerG.ThrottleExecution()
	RunService.Heartbeat:Wait()
end

local RuntimeOptimizerH = {}
function RuntimeOptimizerH.EnsureThreadSafety()
	return getgenv().TrackerActive == true
end

local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
	Name = "Tracker",
	LoadingTitle = "Loading",
	LoadingSubtitle = "by tengo_yo",
	ConfigurationSaving = { Enabled = false },
	KeySystem = false
})

local MainTab = Window:CreateTab("Main", 4483362458)
local StatusLabel = MainTab:CreateLabel("Status: Running")

MainTab:CreateToggle({
	Name = "Air Suspension",
	CurrentValue = false,
	Callback = function(Value)
		ButtonControllerEngineA.InitializeAirSuspensionHook(function()
			ButtonControllerEngineH.ExecuteCallbackSafely(function()
				if Value then
					StatusLabel:Set("Status: Suspended")
					LogTelemetry("Suspension ON")
					task.spawn(function()
						while Value and getgenv().TrackerActive and RuntimeOptimizerH.EnsureThreadSafety() do
							RuntimeOptimizerG.ThrottleExecution()
							local char = LocalPlayer.Character
							local isValid, hum, root = ValidationEngine.VerifyCharacterUsable(char)
							if isValid then
								PhysicsSafetyUtility.VerifyAndSanitizeRoot(root)
								root.CFrame = root.CFrame + Vector3.new(0, 100, 0)
								PhysicsSafetyUtility.StabilizePlayerMotion(root)
							end
						end
					end)
				else
					StatusLabel:Set("Status: Running")
					LogTelemetry("Suspension OFF")
				end
			end)
		end)
	end,
})

MainTab:CreateToggle({
	Name = "Farm Loop",
	CurrentValue = true,
	Callback = function(Value)
		ButtonControllerEngineB.InitializeFarmLoopHook(function()
			ButtonControllerEngineH.ExecuteCallbackSafely(function()
				if Value then
					StatusLabel:Set("Status: Running")
					LogTelemetry("Farm ON")
					task.spawn(function()
						while Value and getgenv().TrackerActive and RuntimeOptimizerH.EnsureThreadSafety() do
							RuntimeOptimizerG.ThrottleExecution()
							RuntimeOptimizerA.FlushMemory()
							local character = LocalPlayer.Character
							local isValid, humanoid, rootPart = ValidationEngine.VerifyCharacterUsable(character)
							
							if not isValid then
								task.wait(0.5)
								continue
							end
							
							PhysicsSafetyUtility.VerifyAndSanitizeRoot(rootPart)
							
							local target = TargetAnalyzer.FindOptimalTarget(rootPart.Position)
							if not target then
								task.wait(0.2)
								continue
							end
							
							local targetChar = target.Character
							local tValid, targetHum, targetRoot = ValidationEngine.VerifyCharacterUsable(targetChar)
							
							if tValid then
								character = LocalPlayer.Character
								local cValid, cHum, cRoot = ValidationEngine.VerifyCharacterUsable(character)
								
								if not cValid then
									task.wait(0.2)
									continue
								end
								
								cRoot.CFrame = targetRoot.CFrame * CFrame.new(0, 3, 0)
								PhysicsSafetyUtility.StabilizePlayerMotion(cRoot)
								
								local isDead = false
								local diedConn = targetHum.Died:Connect(function()
									isDead = true
								end)
								
								while Value and getgenv().TrackerActive and not isDead and targetHum.Health > 0 do
									RuntimeOptimizerG.ThrottleExecution()
									local curChar = LocalPlayer.Character
									local curValid, curHum, curRoot = ValidationEngine.VerifyCharacterUsable(curChar)
									
									if not curValid then break end
									
									local tRoot = target.Character and target.Character:FindFirstChild("HumanoidRootPart")
									if tRoot and curRoot then
										curRoot.CFrame = tRoot.CFrame * CFrame.new(0, 3, 0)
										PhysicsSafetyUtility.StabilizePlayerMotion(curRoot)
									end
								end
								
								if diedConn then diedConn:Disconnect() end
								
								local killTime = tick()
								local savedUpPosition = nil
								
								while Value and getgenv().TrackerActive and (tick() - killTime) < 1.5 do
									RuntimeOptimizerG.ThrottleExecution()
									local curChar = LocalPlayer.Character
									local curValid, curHum, curRoot = ValidationEngine.VerifyCharacterUsable(curChar)
									
									if not curValid then break end
									
									if curRoot then
										if not savedUpPosition then
											savedUpPosition = curRoot.Position + Vector3.new(0, 900, 0)
										end
										curRoot.CFrame = CFrame.new(savedUpPosition)
										PhysicsSafetyUtility.StabilizePlayerMotion(curRoot)
									end
								end
							else
								task.wait(0.2)
							end
						end
					end)
				else
					StatusLabel:Set("Status: Stopped")
					LogTelemetry("Farm OFF")
				end
			end)
		end)
	end,
})

local TargetInput = ""
MainTab:CreateInput({
	Name = "Whitelist Username",
	PlaceholderText = "Username",
	RemoveTextAfterFocusLost = false,
	Callback = function(Text)
		TargetInput = ButtonControllerEngineF.SanitizeButtonInput(Text)
	end,
})

MainTab:CreateButton({
	Name = "Add Whitelist",
	Callback = function()
		ButtonControllerEngineC.InitializeWhitelistHook(function()
			ButtonControllerEngineH.ExecuteCallbackSafely(function()
				if TargetInput ~= "" then
					Whitelist[TargetInput] = true
					RuntimeOptimizerF.CleanRegistry()
					StatusLabel:Set("Whitelisted: " .. TargetInput)
					LogTelemetry("Whitelist: " .. TargetInput)
					task.delay(2, function()
						StatusLabel:Set("Status: Running")
					end)
				end
			end)
		end)
	end,
})

local DiagnosticDaemon = {}

function DiagnosticDaemon.RunHealthCheck()
	task.spawn(function()
		while getgenv().TrackerActive do
			pcall(function()
				local char = LocalPlayer.Character
				if char then
					local hum = char:FindFirstChildOfClass("Humanoid")
					if hum and hum.Health <= 0 then
						LogTelemetry("Dead")
					end
				end
			end)
			task.wait(5)
		end
	end)
end

DiagnosticDaemon.RunHealthCheck()
