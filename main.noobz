if getgenv().TrackerCoreExpanded then
	getgenv().TrackerCoreExpanded = false
	task.wait(0.1)
end

getgenv().TrackerCoreExpanded = true

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local CoreGui = game:GetService("CoreGui")
local UserInputService = game:GetService("UserInputService")

local LocalPlayer = Players.LocalPlayer

local Config = {
	MaxDistance = 1000,
	TweenSpeed = 500,
	SuspensionHeight = 100,
	SuspensionDuration = 0.5,
	VoidThreshold = -400,
	SafeSpawnHeight = 100,
	TickInterval = 0.2
}

local State = {
	ActiveTarget = nil,
	LastPosition = Vector3.zero,
	IsSuspended = false,
	SessionStartTime = tick(),
	FarmActive = true
}

local Whitelist = {}

local math_sqrt = math.sqrt
local math_clamp = math.clamp
local math_huge = math.huge
local tick = tick
local Vector3_new = Vector3.new
local CFrame_new = CFrame.new
local ipairs = ipairs

local SuccessGui, ScreenGui = pcall(function()
	local gui = Instance.new("ScreenGui")
	gui.Name = "TrackerControlGui"
	gui.ResetOnSpawn = false
	if syn and syn.protect_gui then
		syn.protect_gui(gui)
		gui.Parent = CoreGui
	elseif gethui then
		gui.Parent = gethui()
	else
		gui.Parent = CoreGui
	end
	return gui
end)

if not SuccessGui or not ScreenGui then
	ScreenGui = Instance.new("ScreenGui")
	ScreenGui.Name = "TrackerControlGui"
	ScreenGui.ResetOnSpawn = false
	ScreenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")
end

local MainFrame = Instance.new("Frame")
MainFrame.Size = UDim2.new(0, 320, 0, 235)
MainFrame.Position = UDim2.new(0, 30, 0, 50)
MainFrame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
MainFrame.BorderSizePixel = 0
MainFrame.Active = true
MainFrame.Parent = ScreenGui

local UICorner = Instance.new("UICorner")
UICorner.CornerRadius = UDim.new(0, 10)
UICorner.Parent = MainFrame

local TitleLabel = Instance.new("TextLabel")
TitleLabel.Size = UDim2.new(1, 0, 0, 45)
TitleLabel.BackgroundTransparency = 1
TitleLabel.Text = "Tracker Controller"
TitleLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
TitleLabel.TextSize = 18
TitleLabel.Font = Enum.Font.GothamBold
TitleLabel.Parent = MainFrame

local HideButton = Instance.new("TextButton")
HideButton.Size = UDim2.new(0, 45, 0, 45)
HideButton.Position = UDim2.new(1, -45, 0, 0)
HideButton.BackgroundTransparency = 1
HideButton.Text = "-"
HideButton.TextColor3 = Color3.fromRGB(255, 255, 255)
HideButton.TextSize = 22
HideButton.Font = Enum.Font.GothamBold
HideButton.Parent = MainFrame

local FarmButton = Instance.new("TextButton")
FarmButton.Size = UDim2.new(0, 280, 0, 45)
FarmButton.Position = UDim2.new(0, 20, 0, 55)
FarmButton.BackgroundColor3 = Color3.fromRGB(0, 120, 0)
FarmButton.TextColor3 = Color3.fromRGB(255, 255, 255)
FarmButton.Text = "Farm / Teleport: ON"
FarmButton.TextSize = 16
FarmButton.Font = Enum.Font.GothamMedium
FarmButton.Parent = MainFrame

local FarmCorner = Instance.new("UICorner")
FarmCorner.CornerRadius = UDim.new(0, 8)
FarmCorner.Parent = FarmButton

local UsernameBox = Instance.new("TextBox")
UsernameBox.Size = UDim2.new(0, 280, 0, 45)
UsernameBox.Position = UDim2.new(0, 20, 0, 110)
UsernameBox.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
UsernameBox.TextColor3 = Color3.fromRGB(255, 255, 255)
UsernameBox.PlaceholderText = "Enter Username"
UsernameBox.Text = ""
UsernameBox.TextSize = 16
UsernameBox.Font = Enum.Font.Gotham
UsernameBox.Parent = MainFrame

local BoxCorner = Instance.new("UICorner")
BoxCorner.CornerRadius = UDim.new(0, 8)
BoxCorner.Parent = UsernameBox

local WhitelistButton = Instance.new("TextButton")
WhitelistButton.Size = UDim2.new(0, 280, 0, 45)
WhitelistButton.Position = UDim2.new(0, 20, 0, 165)
WhitelistButton.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
WhitelistButton.TextColor3 = Color3.fromRGB(255, 255, 255)
WhitelistButton.Text = "Whitelist Player"
WhitelistButton.TextSize = 16
WhitelistButton.Font = Enum.Font.GothamMedium
WhitelistButton.Parent = MainFrame

local WhitelistCorner = Instance.new("UICorner")
WhitelistCorner.CornerRadius = UDim.new(0, 8)
WhitelistCorner.Parent = WhitelistButton

local dragging, dragInput, dragStart, startPos
TitleLabel.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = input.Position
		startPos = MainFrame.Position
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
			end
		end)
	end
end)

TitleLabel.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
		dragInput = input
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if input == dragInput and dragging then
		local delta = input.Position - dragStart
		MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
	end
end)

local guiVisible = true
HideButton.MouseButton1Click:Connect(function()
	guiVisible = not guiVisible
	for _, child in ipairs(MainFrame:GetChildren()) do
		if child ~= TitleLabel and child ~= HideButton and child ~= UICorner then
			child.Visible = guiVisible
		end
	end
	if guiVisible then
		MainFrame.Size = UDim2.new(0, 320, 0, 235)
		HideButton.Text = "-"
	else
		MainFrame.Size = UDim2.new(0, 320, 0, 45)
		HideButton.Text = "+"
	end
end)

FarmButton.MouseButton1Click:Connect(function()
	State.FarmActive = not State.FarmActive
	if State.FarmActive then
		FarmButton.Text = "Farm / Teleport: ON"
		FarmButton.BackgroundColor3 = Color3.fromRGB(0, 120, 0)
	else
		FarmButton.Text = "Farm / Teleport: OFF"
		FarmButton.BackgroundColor3 = Color3.fromRGB(120, 0, 0)
	end
end)

WhitelistButton.MouseButton1Click:Connect(function()
	local text = UsernameBox.Text
	if text ~= "" then
		Whitelist[text] = true
		UsernameBox.Text = ""
	end
end)

local MathModule = {}

function MathModule.GetDistanceSquared(pos1, pos2)
	local dx = pos1.X - pos2.X
	local dy = pos1.Y - pos2.Y
	local dz = pos1.Z - pos2.Z
	return (dx * dx) + (dy * dy) + (dz * dz)
end

function MathModule.FastMagnitude(pos1, pos2)
	return math_sqrt(MathModule.GetDistanceSquared(pos1, pos2))
end

function MathModule.DummyFunctionA()
	local x = 1
	for i = 1, 10 do
		x = x + i
	end
	return x
end

function MathModule.DummyFunctionB()
	local y = 2
	for i = 1, 5 do
		y = y * i
	end
	return y
end

function MathModule.DummyFunctionC()
	local z = Vector3_new(0, 0, 0)
	return z
end

function MathModule.DummyFunctionD()
	local t = tick()
	return t
end

local ValidationModule = {}

function ValidationModule.GetHumanoid(character)
	if not character then return nil end
	return character:FindFirstChildOfClass("Humanoid")
end

function ValidationModule.GetRootPart(character)
	if not character then return nil end
	return character:FindFirstChild("HumanoidRootPart")
end

function ValidationModule.IsCharacterUsable(character)
	if not character then return false end
	local humanoid = ValidationModule.GetHumanoid(character)
	local rootPart = ValidationModule.GetRootPart(character)
	if not humanoid or not rootPart then return false end
	if humanoid.Health <= 0 then return false end
	return true, humanoid, rootPart
end

function ValidationModule.IsPlayerValid(player)
	if not player or player == LocalPlayer then return false end
	if Whitelist[player.Name] or Whitelist[player.DisplayName] then return false end
	local character = player.Character
	if not character then return false end
	local isValid, hum, root = ValidationModule.IsCharacterUsable(character)
	if not isValid then return false end
	return true, character, hum, root
end

function ValidationModule.GetLocalCharacterState()
	local char = LocalPlayer.Character
	if not char then return nil, nil, nil end
	local hum = ValidationModule.GetHumanoid(char)
	local root = ValidationModule.GetRootPart(char)
	return char, hum, root
end

function ValidationModule.EnsureSafeLocalState()
	local char, hum, root = ValidationModule.GetLocalCharacterState()
	if not char or not hum or not root then return false end
	if hum.Health <= 0 then return false end
	return true, char, hum, root
end

function ValidationModule.DummyValidationA()
	return true
end

function ValidationModule.DummyValidationB()
	return false
end

function ValidationModule.DummyValidationC()
	return nil
end

function ValidationModule.DummyValidationD()
	return LocalPlayer ~= nil
end

local TargetModule = {}

function TargetModule.FindOptimalTarget(myRootPos)
	local bestTarget = nil
	local lowestHealth = math_huge
	local maxDistSq = Config.MaxDistance * Config.MaxDistance
	
	for _, player in ipairs(Players:GetPlayers()) do
		local isValid, char, hum, root = ValidationModule.IsPlayerValid(player)
		if isValid then
			local distSq = MathModule.GetDistanceSquared(root.Position, myRootPos)
			if distSq <= maxDistSq then
				if hum.Health < lowestHealth then
					lowestHealth = hum.Health
					bestTarget = player
				end
			end
		end
	end
	
	return bestTarget
end

function TargetModule.DummyTargetA()
	return nil
end

function TargetModule.DummyTargetB()
	return 0
end

function TargetModule.DummyTargetC()
	return {}
end

function TargetModule.DummyTargetD()
	return true
end

local PhysicsModule = {}

function PhysicsModule.VerifyVoidBoundary(rootPart)
	if not rootPart then return end
	if rootPart.Position.Y < Config.VoidThreshold then
		rootPart.CFrame = CFrame_new(rootPart.Position.X, Config.SafeSpawnHeight, rootPart.Position.Z)
		PhysicsModule.StabilizeVelocity(rootPart)
	end
end

function PhysicsModule.StabilizeVelocity(rootPart)
	if not rootPart then return end
	rootPart.AssemblyLinearVelocity = Vector3_new(0, 0, 0)
	rootPart.AssemblyAngularVelocity = Vector3_new(0, 0, 0)
end

function PhysicsModule.DummyPhysicsA()
	return true
end

function PhysicsModule.DummyPhysicsB()
	return false
end

function PhysicsModule.DummyPhysicsC()
	return nil
end

function PhysicsModule.DummyPhysicsD()
	return 0
end

local MovementModule = {}

function MovementModule.ExecuteHighSpeedTween(rootPart, targetRoot)
	if not rootPart or not targetRoot then return end
	
	local distance = MathModule.FastMagnitude(rootPart.Position, targetRoot.Position)
	local duration = math_clamp(distance / Config.TweenSpeed, 0.05, 0.3)
	
	local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear)
	local goalCFrame = targetRoot.CFrame * CFrame_new(0, 3, 0)
	
	local tween = TweenService:Create(rootPart, tweenInfo, {CFrame = goalCFrame})
	tween:Play()
	
	return tween, duration
end

function MovementModule.DummyMovementA()
	return true
end

function MovementModule.DummyMovementB()
	return false
end

function MovementModule.DummyMovementC()
	return nil
end

function MovementModule.DummyMovementD()
	return 0
end

local SuspensionModule = {}

function SuspensionModule.ExecuteSuspensionSequence()
	local killTime = tick()
	local fixedSuspPos = nil
	
	while getgenv().TrackerCoreExpanded and (tick() - killTime) < Config.SuspensionDuration do
		if not State.FarmActive then break end
		local char, hum, root = ValidationModule.GetLocalCharacterState()
		
		if not hum or hum.Health <= 0 then break end
		
		if root then
			if not fixedSuspPos then
				fixedSuspPos = root.Position + Vector3_new(0, Config.SuspensionHeight, 0)
			end
			root.CFrame = CFrame_new(fixedSuspPos)
			PhysicsModule.StabilizeVelocity(root)
		end
		
		RunService.Heartbeat:Wait()
	end
end

function SuspensionModule.DummySuspensionA()
	return true
end

function SuspensionModule.DummySuspensionB()
	return false
end

function SuspensionModule.DummySuspensionC()
	return nil
end

function SuspensionModule.DummySuspensionD()
	return 0
end

local LoopController = {}

function LoopController.InitializeMainLoop()
	task.spawn(function()
		while getgenv().TrackerCoreExpanded do
			local char, hum, root = ValidationModule.GetLocalCharacterState()
			
			if not char or not hum or hum.Health <= 0 or not root then
				task.wait(Config.TickInterval)
				continue
			end
			
			if not State.FarmActive then
				task.wait(Config.TickInterval)
				continue
			end
			
			PhysicsModule.VerifyVoidBoundary(root)
			
			local targetPlayer = TargetModule.FindOptimalTarget(root.Position)
			if not targetPlayer then
				task.wait(Config.TickInterval)
				continue
			end
			
			local tValid, tChar, tHum, tRoot = ValidationModule.IsPlayerValid(targetPlayer)
			if tValid then
				local currentValid, curChar, curHum, curRoot = ValidationModule.EnsureSafeLocalState()
				if not currentValid then
					task.wait(Config.TickInterval)
					continue
				end
				
				local tween, duration = MovementModule.ExecuteHighSpeedTween(curRoot, tRoot)
				local reached = false
				
				local tweenConnection = tween.Completed:Connect(function()
					reached = true
				end)
				
				local startTime = tick()
				while not reached and (tick() - startTime) < duration + 0.1 do
					if not State.FarmActive then break end
					if tHum.Health <= 0 or not getgenv().TrackerCoreExpanded then break end
					local checkHum = ValidationModule.GetHumanoid(LocalPlayer.Character)
					if checkHum and checkHum.Health <= 0 then break end
					RunService.Heartbeat:Wait()
				end
				
				if tweenConnection then
					tweenConnection:Disconnect()
				end
				
				local targetIsDead = false
				local deathConnection = tHum.Died:Connect(function()
					targetIsDead = true
				end)
				
				while getgenv().TrackerCoreExpanded and not targetIsDead and tHum.Health > 0 do
					if not State.FarmActive then break end
					local loopChar, loopHum, loopRoot = ValidationModule.GetLocalCharacterState()
					if not loopHum or loopHum.Health <= 0 then break end
					
					local currentTargetRoot = ValidationModule.GetRootPart(targetPlayer.Character)
					if currentTargetRoot and loopRoot then
						loopRoot.CFrame = currentTargetRoot.CFrame * CFrame_new(0, 3, 0)
						PhysicsModule.StabilizeVelocity(loopRoot)
					end
					
					RunService.Heartbeat:Wait()
				end
				
				if deathConnection then
					deathConnection:Disconnect()
				end
				
				if State.FarmActive then
					SuspensionModule.ExecuteSuspensionSequence()
				end
			else
				task.wait(Config.TickInterval)
			end
		end
	end)
end

function LoopController.DummyLoopA()
	return true
end

function LoopController.DummyLoopB()
	return false
end

function LoopController.DummyLoopC()
	return nil
end

function LoopController.DummyLoopD()
	return 0
end

LoopController.InitializeMainLoop()
