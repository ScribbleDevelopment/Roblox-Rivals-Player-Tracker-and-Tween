-- Update Whitelist UI List
local function RefreshWhitelistUI()
	for _, child in ipairs(WhitelistScroll:GetChildren()) do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end
	
	local count = 0
	for name, _ in pairs(Whitelist) do
		count = count + 1
		local btn = Instance.new("TextButton")
		btn.Size = UDim2.new(1, -6, 0, 28)
		btn.BackgroundColor3 = Color3.fromRGB(50, 40, 75)
		btn.BackgroundTransparency = 0.3
		btn.TextColor3 = Color3.fromRGB(230, 220, 250)
		btn.Text = "  " .. name .. " (Click to Unwhitelist)"
		btn.TextSize = 11
		btn.Font = Enum.Font.Gotham
		btn.TextXAlignment = Enum.TextXAlignment.Left
		btn.Parent = WhitelistScroll
		
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 6)
		corner.Parent = btn
		
		btn.MouseButton1Click:Connect(function()
			Whitelist[name] = nil
			RefreshWhitelistUI()
		end)
	end
	WhitelistScroll.CanvasSize = UDim2.new(0, 0, 0, count * 32)
end

-- Update Server Players UI List with interactive options
local function RefreshPlayerListUI()
	for _, child in ipairs(PlayerScroll:GetChildren()) do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end
	
	local count = 0
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then
			count = count + 1
			local row = Instance.new("Frame")
			row.Size = UDim2.new(1, -6, 0, 32)
			row.BackgroundColor3 = Color3.fromRGB(30, 25, 45)
			row.BackgroundTransparency = 0.3
			row.Parent = PlayerScroll
			
			local rowCorner = Instance.new("UICorner")
			rowCorner.CornerRadius = UDim.new(0, 6)
			rowCorner.Parent = row
			
			local nameLabel = Instance.new("TextLabel")
			nameLabel.Size = UDim2.new(0, 110, 1, 0)
			nameLabel.Position = UDim2.new(0, 8, 0, 0)
			nameLabel.BackgroundTransparency = 1
			nameLabel.Text = player.Name
			nameLabel.TextColor3 = Color3.fromRGB(230, 220, 250)
			nameLabel.TextSize = 11
			nameLabel.Font = Enum.Font.GothamSemibold
			nameLabel.TextXAlignment = Enum.TextXAlignment.Left
			nameLabel.Parent = row
			
			-- Target Button
			local targetBtn = Instance.new("TextButton")
			targetBtn.Size = UDim2.new(0, 58, 0, 24)
			targetBtn.Position = UDim2.new(1, -127, 0, 4)
			targetBtn.BackgroundColor3 = Color3.fromRGB(180, 50, 120)
			targetBtn.BackgroundTransparency = 0.2
			targetBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
			targetBtn.Text = "Target"
			targetBtn.TextSize = 10
			targetBtn.Font = Enum.Font.GothamBold
			targetBtn.Parent = row
			
			local tCorner = Instance.new("UICorner")
			tCorner.CornerRadius = UDim.new(0, 5)
			tCorner.Parent = targetBtn
			
			targetBtn.MouseButton1Click:Connect(function()
				State.LockedTarget = player
				TargetStatusLabel.Text = "Locked: " .. player.Name
			end)
			
			-- Whitelist Button
			local wlBtn = Instance.new("TextButton")
			wlBtn.Size = UDim2.new(0, 55, 0, 24)
			wlBtn.Position = UDim2.new(1, -62, 0, 4)
			wlBtn.BackgroundColor3 = Color3.fromRGB(70, 50, 110)
			wlBtn.BackgroundTransparency = 0.2
			wlBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
			wlBtn.Text = Whitelist[player.Name] and "W/L'd" or "Whitelist"
			wlBtn.TextSize = 10
			wlBtn.Font = Enum.Font.GothamBold
			wlBtn.Parent = row
			
			local wCorner = Instance.new("UICorner")
			wCorner.CornerRadius = UDim.new(0, 5)
			wCorner.Parent = wlBtn
			
			wlBtn.MouseButton1Click:Connect(function()
				if Whitelist[player.Name] then
					Whitelist[player.Name] = nil
					wlBtn.Text = "Whitelist"
				else
					Whitelist[player.Name] = true
					wlBtn.Text = "W/L'd"
					if State.LockedTarget == player then
						State.LockedTarget = nil
						TargetStatusLabel.Text = "Locked Target: None"
					end
				end
				RefreshWhitelistUI()
			end)
		end
	end
	PlayerScroll.CanvasSize = UDim2.new(0, 0, 0, count * 36)
end

Players.PlayerAdded:Connect(RefreshPlayerListUI)
Players.PlayerRemoving:Connect(RefreshPlayerListUI)
task.spawn(function()
	while task.wait(2) do
		RefreshPlayerListUI()
	end
end)
RefreshPlayerListUI()

-- Smooth Drag Logic
local dragging, dragInput, dragStart, startPos
TitleBar.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = input.Position
		startPos = MainFrame.Position
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
			end
		end)
	end
end)

TitleBar.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
		dragInput = input
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if input == dragInput and dragging then
		local delta = input.Position - dragStart
		MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
	end
end)

local guiVisible = true
HideButton.MouseButton1Click:Connect(function()
	guiVisible = not guiVisible
	Container.Visible = guiVisible
	if guiVisible then
		MainFrame.Size = UDim2.new(0, 520, 0, 360)
		HideButton.Text = "-"
	else
		MainFrame.Size = UDim2.new(0, 520, 0, 45)
		HideButton.Text = "+"
	end
end)

FarmButton.MouseButton1Click:Connect(function()
	State.FarmActive = not State.FarmActive
	if State.FarmActive then
		FarmButton.Text = "Farm: ON"
		FarmGradient.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(80, 210, 110)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(40, 140, 70))
		})
	else
		FarmButton.Text = "Farm: OFF"
		FarmGradient.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(220, 70, 70)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(150, 30, 30))
		})
	end
end)

UntargetButton.MouseButton1Click:Connect(function()
	State.LockedTarget = nil
	TargetStatusLabel.Text = "Locked Target: None"
end)

local MathModule = {}

function MathModule.GetDistanceSquared(pos1, pos2)
	local dx = pos1.X - pos2.X
	local dy = pos1.Y - pos2.Y
	local dz = pos1.Z - pos2.Z
	return (dx * dx) + (dy * dy) + (dz * dz)
end

function MathModule.FastMagnitude(pos1, pos2)
	return math_sqrt(MathModule.GetDistanceSquared(pos1, pos2))
end

local ValidationModule = {}

function ValidationModule.GetHumanoid(character)
	if not character then return nil end
	return character:FindFirstChildOfClass("Humanoid")
end

function ValidationModule.GetRootPart(character)
	if not character then return nil end
	return character:FindFirstChild("HumanoidRootPart")
end

function ValidationModule.IsCharacterUsable(character)
	if not character then return false end
	local humanoid = ValidationModule.GetHumanoid(character)
	local rootPart = ValidationModule.GetRootPart(character)
	if not humanoid or not rootPart then return false end
	if humanoid.Health <= 0 then return false end
	return true, humanoid, rootPart
end

function ValidationModule.IsPlayerValid(player)
	if not player or player == LocalPlayer then return false end
	if Whitelist[player.Name] or Whitelist[player.DisplayName] then return false end
	local character = player.Character
	if not character then return false end
	local isValid, hum, root = ValidationModule.IsCharacterUsable(character)
	if not isValid then return false end
	return true, character, hum, root
end

function ValidationModule.GetLocalCharacterState()
	local char = LocalPlayer.Character
	if not char then return nil, nil, nil end
	local hum = ValidationModule.GetHumanoid(char)
	local root = ValidationModule.GetRootPart(char)
	return char, hum, root
end

function ValidationModule.EnsureSafeLocalState()
	local char, hum, root = ValidationModule.GetLocalCharacterState()
	if not char or not hum or not root then return false end
	if hum.Health <= 0 then return false end
	return true, char, hum, root
end

local TargetModule = {}

function TargetModule.FindOptimalTarget(myRootPos)
	if State.LockedTarget then
		local isValid, char, hum, root = ValidationModule.IsPlayerValid(State.LockedTarget)
		if isValid then
			return State.LockedTarget
		else
			return nil
		end
	end
	
	local bestTarget = nil
	local lowestHealth = math_huge
	local maxDistSq = Config.MaxDistance * Config.MaxDistance
	
	for _, player in ipairs(Players:GetPlayers()) do
		local isValid, char, hum, root = ValidationModule.IsPlayerValid(player)
		if isValid then
			local distSq = MathModule.GetDistanceSquared(root.Position, myRootPos)
			if distSq <= maxDistSq then
				if hum.Health < lowestHealth then
					lowestHealth = hum.Health
					bestTarget = player
				end
			end
		end
	end
	
	return bestTarget
end

local PhysicsModule = {}

function PhysicsModule.VerifyVoidBoundary(rootPart)
	if not rootPart then return end
	if rootPart.Position.Y < Config.VoidThreshold then
		rootPart.CFrame = CFrame_new(rootPart.Position.X, Config.SafeSpawnHeight, rootPart.Position.Z)
		PhysicsModule.StabilizeVelocity(rootPart)
	end
end

function PhysicsModule.StabilizeVelocity(rootPart)
	if not rootPart then return end
	rootPart.AssemblyLinearVelocity = Vector3_new(0, 0, 0)
	rootPart.AssemblyAngularVelocity = Vector3_new(0, 0, 0)
end

local MovementModule = {}

function MovementModule.ExecuteInstantTeleport(rootPart, targetRoot)
	if not rootPart or not targetRoot then return end
	rootPart.CFrame = targetRoot.CFrame * CFrame_new(0, 3, 0)
	PhysicsModule.StabilizeVelocity(rootPart)
end

local SuspensionModule = {}

function SuspensionModule.ExecuteSuspensionSequence()
	local killTime = tick()
	local fixedSuspPos = nil
	
	while getgenv().TrackerCoreExpanded and (tick() - killTime) < Config.SuspensionDuration do
		if not State.FarmActive then break end
		local char, hum, root = ValidationModule.GetLocalCharacterState()
		
		if not hum or hum.Health <= 0 then break end
		
		if root then
			if not fixedSuspPos then
				fixedSuspPos = root.Position + Vector3_new(0, Config.SuspensionHeight, 0)
			end
			root.CFrame = CFrame_new(fixedSuspPos)
			PhysicsModule.StabilizeVelocity(root)
		end
		
		RunService.Heartbeat:Wait()
	end
end

local LoopController = {}

function LoopController.InitializeMainLoop()
	task.spawn(function()
		while getgenv().TrackerCoreExpanded do
			local char, hum, root = ValidationModule.GetLocalCharacterState()
			
			if not char or not hum or hum.Health <= 0 or not root then
				task.wait(Config.TickInterval)
				continue
			end
			
			if not State.FarmActive then
				task.wait(Config.TickInterval)
				continue
			end
			
			PhysicsModule.VerifyVoidBoundary(root)
			
			local targetPlayer = TargetModule.FindOptimalTarget(root.Position)
			if not targetPlayer then
				task.wait(Config.TickInterval)
				continue
			end
			
			local tValid, tChar, tHum, tRoot = ValidationModule.IsPlayerValid(targetPlayer)
			if tValid then
				local currentValid, curChar, curHum, curRoot = ValidationModule.EnsureSafeLocalState()
				if not currentValid then
					task.wait(Config.TickInterval)
					continue
				end
				
				MovementModule.ExecuteInstantTeleport(curRoot, tRoot)
				
				local targetIsDead = false
				local deathConnection = tHum.Died:Connect(function()
					targetIsDead = true
				end)
				
				while getgenv().TrackerCoreExpanded and not targetIsDead and tHum.Health > 0 do
					if not State.FarmActive then break end
					local loopChar, loopHum, loopRoot = ValidationModule.GetLocalCharacterState()
					if not loopHum or loopHum.Health <= 0 then break end
					
					local currentTargetRoot = ValidationModule.GetRootPart(targetPlayer.Character)
					if currentTargetRoot and loopRoot then
						loopRoot.CFrame = currentTargetRoot.CFrame * CFrame_new(0, 3, 0)
						PhysicsModule.StabilizeVelocity(loopRoot)
					end
					
					RunService.Heartbeat:Wait()
				end
				
				if deathConnection then
					deathConnection:Disconnect()
				end
				
				if State.FarmActive then
					SuspensionModule.ExecuteSuspensionSequence()
				end
			else
				task.wait(Config.TickInterval)
			end
		end
	end)
end

LoopController.InitializeMainLoop()
