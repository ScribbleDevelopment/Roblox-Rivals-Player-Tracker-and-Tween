-- Rayfield UI Target Tracker Framework
-- Designed for mobile executors and Rayfield interface

if getgenv().RayfieldTracker then
	getgenv().RayfieldTracker = false
	task.wait(0.1)
end

getgenv().RayfieldTracker = true

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

local Config = {
	MaxDistance = 1000,
	SuspensionHeight = 100,
	SuspensionDuration = 0.5,
	VoidThreshold = -400,
	SafeSpawnHeight = 100,
	TickInterval = 0.2
}

local State = {
	ManualSuspension = false,
	FarmActive = true
}

local Whitelist = {}
local math_huge = math.huge
local Vector3_new = Vector3.new
local CFrame_new = CFrame_new

-- Load Rayfield UI Library
local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
	Name = "Scribster UI | Target Tracker",
	LoadingTitle = "Initializing Tracker...",
	LoadingSubtitle = "by tengo_yo (@Messy_tsb)",
	ConfigurationSaving = {
		Enabled = false
	},
	KeySystem = false
})

local MainTab = Window:CreateTab("Main", 4483362458)

local StatusLabel = MainTab:CreateLabel("Status: Running")

MainTab:CreateToggle({
	Name = "Air Suspension (Stay 100 Studs Up)",
	CurrentValue = false,
	Callback = function(Value)
		State.ManualSuspension = Value
		if State.ManualSuspension then
			StatusLabel:Set("Status: Suspended in Air")
		else
			if State.FarmActive then
				StatusLabel:Set("Status: Running")
			else
				StatusLabel:Set("Status: Stopped")
			end
		end
	end,
})

MainTab:CreateToggle({
	Name = "Farm / Teleport Loop",
	CurrentValue = true,
	Callback = function(Value)
		State.FarmActive = Value
		if State.FarmActive then
			if not State.ManualSuspension then
				StatusLabel:Set("Status: Running")
			end
		else
			StatusLabel:Set("Status: Stopped")
		end
	end,
})

local TargetInput = ""
MainTab:CreateInput({
	Name = "Whitelist Username",
	PlaceholderText = "Enter exact username",
	RemoveTextAfterFocusLost = false,	Callback = function(Text)
		TargetInput = Text
	end,
})

MainTab:CreateButton({
	Name = "Add to Whitelist",
	Callback = function()
		if TargetInput ~= "" then
			Whitelist[TargetInput] = true
			StatusLabel:Set("Whitelisted: " .. TargetInput)
			task.delay(2, function()
				if State.ManualSuspension then
					StatusLabel:Set("Status: Suspended in Air")
				elseif State.FarmActive then
					StatusLabel:Set("Status: Running")
				else
					StatusLabel:Set("Status: Stopped")
				end
			end)
		end
	end,
})

local function GetHumanoid(char)
	if not char then return nil end
	return char:FindFirstChildOfClass("Humanoid")
end

local function GetRootPart(char)
	if not char then return nil end
	return char:FindFirstChild("HumanoidRootPart")
end

local function IsPlayerValid(player)
	if not player or player == LocalPlayer then return false end
	if Whitelist[player.Name] or Whitelist[player.DisplayName] then return false end
	local char = player.Character
	if not char then return false end
	local hum = GetHumanoid(char)
	local root = GetRootPart(char)
	if not hum or not root or hum.Health <= 0 then return false end
	return true, char, hum, root
end

task.spawn(function()
	local manualSavedPos = nil
	while getgenv().RayfieldTracker do
		local char = LocalPlayer.Character
		local hum = GetHumanoid(char)
		local root = GetRootPart(char)
		
		if not char or not hum or hum.Health <= 0 or not root then
			manualSavedPos = nil
			task.wait(Config.TickInterval)
			continue
		end
		
		if not State.FarmActive then
			manualSavedPos = nil
			task.wait(Config.TickInterval)
			continue
		end
		
		if State.ManualSuspension then
			if not manualSavedPos then
				manualSavedPos = root.Position + Vector3_new(0, Config.SuspensionHeight, 0)
			end
			root.CFrame = CFrame_new(manualSavedPos)
			root.AssemblyLinearVelocity = Vector3_new(0, 0, 0)
			root.AssemblyAngularVelocity = Vector3_new(0, 0, 0)
			RunService.Heartbeat:Wait()
			continue
		else
			manualSavedPos = nil
		end
		
		if root.Position.Y < Config.VoidThreshold then
			root.CFrame = CFrame_new(root.Position.X, Config.SafeSpawnHeight, root.Position.Z)
			root.AssemblyLinearVelocity = Vector3_new(0, 0, 0)
		end
		
		local bestTarget = nil
		local lowestHealth = math_huge
		local maxDistSq = Config.MaxDistance * Config.MaxDistance
		
		for _, player in ipairs(Players:GetPlayers()) do
			local isValid, _, tHum, tRoot = IsPlayerValid(player)
			if isValid then
				local dx = tRoot.Position.X - root.Position.X
				local dy = tRoot.Position.Y - root.Position.Y
				local dz = tRoot.Position.Z - root.Position.Z
				local distSq = (dx * dx) + (dy * dy) + (dz * dz)
				if distSq <= maxDistSq then
					if tHum.Health < lowestHealth then
						lowestHealth = tHum.Health
						bestTarget = player
					end
				end
			end
		end
		
		if bestTarget then
			local _, tChar, tHum, tRoot = IsPlayerValid(bestTarget)
			if tRoot and tHum and tHum.Health > 0 then
				root.CFrame = tRoot.CFrame * CFrame_new(0, 3, 0)
				root.AssemblyLinearVelocity = Vector3_new(0, 0, 0)
				
				local targetIsDead = false
				local diedConn = tHum.Died:Connect(function()
					targetIsDead = true
				end)
				
				while getgenv().RayfieldTracker and not targetIsDead and tHum.Health > 0 do
					if State.ManualSuspension or not State.FarmActive then break end
					local curChar = LocalPlayer.Character
					local curHum = GetHumanoid(curChar)
					local curRoot = GetRootPart(curChar)
					if not curHum or curHum.Health <= 0 then break end
					
					local currentTargetRoot = GetRootPart(bestTarget.Character)
					if currentTargetRoot and curRoot then
						curRoot.CFrame = currentTargetRoot.CFrame * CFrame_new(0, 3, 0)
						curRoot.AssemblyLinearVelocity = Vector3_new(0, 0, 0)
					end
					RunService.Heartbeat:Wait()
				end
				
				if diedConn then diedConn:Disconnect() end
				
				if not State.ManualSuspension and State.FarmActive then
					local killTime = tick()
					local savedUpPos = nil
					while getgenv().RayfieldTracker and (tick() - killTime) < Config.SuspensionDuration do
						if State.ManualSuspension or not State.FarmActive then break end
						local cChar = LocalPlayer.Character
						local cHum = GetHumanoid(cChar)
						local cRoot = GetRootPart(cChar)
						if not cHum or cHum.Health <= 0 then break end
						if cRoot then
							if not savedUpPos then
								savedUpPos = cRoot.Position + Vector3_new(0, Config.SuspensionHeight, 0)
							end
							cRoot.CFrame = CFrame_new(savedUpPos)
							cRoot.AssemblyLinearVelocity = Vector3_new(0, 0, 0)
						end
						RunService.Heartbeat:Wait()
					end
				end
			else
				task.wait(Config.TickInterval)
			end
		else
			task.wait(Config.TickInterval)
		end
	end
end)
