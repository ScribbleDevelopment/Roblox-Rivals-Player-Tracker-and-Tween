-- Stop any previously running tracker instances
if getgenv().TrackerActive then
	getgenv().TrackerActive = false
	task.wait(0.1)
end

getgenv().TrackerActive = true

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local CoreGui = game:GetService("CoreGui")
local LocalPlayer = Players.LocalPlayer

local Whitelist = {}

local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
	Name = "Scribster UI | Target Tracker",
	LoadingTitle = "Initializing Tracker...",
	LoadingSubtitle = "by tengo_yo (@Messy_tsb)",
	ConfigurationSaving = { Enabled = false },
	KeySystem = false
})

local MainTab = Window:CreateTab("Main", 4483362458)
local StatusLabel = MainTab:CreateLabel("Status: Running")

MainTab:CreateToggle({
	Name = "Air Suspension (Stay 100 Studs Up)",
	CurrentValue = false,
	Callback = function(Value)
		if Value then
			StatusLabel:Set("Status: Suspended in Air")
			task.spawn(function()
				while getgenv().TrackerActive and _G.RayfieldManualSuspension do
					local char = LocalPlayer.Character
					local hum = char and char:FindFirstChildOfClass("Humanoid")
					local root = char and char:FindFirstChild("HumanoidRootPart")
					if hum and hum.Health > 0 and root then
						root.CFrame = root.CFrame + Vector3.new(0, 100, 0)
						root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
						root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
					end
					RunService.Heartbeat:Wait()
				end
			end)
		else
			StatusLabel:Set("Status: Running")
		end
	end,
})

MainTab:CreateToggle({
	Name = "Farm / Teleport Loop",
	CurrentValue = true,
	Callback = function(Value)
		if Value then
			StatusLabel:Set("Status: Running")
		else
			StatusLabel:Set("Status: Stopped")
		end
	end,
})

local TargetInput = ""
MainTab:CreateInput({
	Name = "Whitelist Username",
	PlaceholderText = "Enter exact username",
	RemoveTextAfterFocusLost = false,
	Callback = function(Text)
		TargetInput = Text
	end,
})

MainTab:CreateButton({
	Name = "Add to Whitelist",
	Callback = function()
		if TargetInput ~= "" then
			Whitelist[TargetInput] = true
			StatusLabel:Set("Whitelisted: " .. TargetInput)
			task.delay(2, function()
				StatusLabel:Set("Status: Running")
			end)
		end
	end,
})

local function getLowestHealthTarget(myRoot)
	local bestTarget = nil
	local lowestHealth = math.huge
	
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LocalPlayer and not Whitelist[p.Name] and not Whitelist[p.DisplayName] then
			local char = p.Character
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			local root = char and char:FindFirstChild("HumanoidRootPart")
			if hum and hum.Health > 0 and root then
				local dist = (root.Position - myRoot.Position).Magnitude
				if dist <= 1000 and hum.Health < lowestHealth then
					lowestHealth = hum.Health
					bestTarget = p
				end
			end
		end
	end
	return bestTarget
end

task.spawn(function()
	while getgenv().TrackerActive do
		local character = LocalPlayer.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local rootPart = character and character:FindFirstChild("HumanoidRootPart")
		
		if not character or not humanoid or humanoid.Health <= 0 or not rootPart then
			task.wait(0.5)
			continue
		end
		
		if rootPart.Position.Y < -400 then
			rootPart.CFrame = CFrame.new(rootPart.Position.X, 100, rootPart.Position.Z)
			rootPart.AssemblyLinearVelocity = Vector3.zero
		end
		
		local target = getLowestHealthTarget(rootPart)
		if not target then
			task.wait(0.2)
			continue
		end
		
		local targetChar = target.Character
		local targetRoot = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
		local targetHum = targetChar and targetChar:FindFirstChildOfClass("Humanoid")
		
		if targetRoot and targetHum and targetHum.Health > 0 then
			character = LocalPlayer.Character
			humanoid = character and character:FindFirstChildOfClass("Humanoid")
			rootPart = character and character:FindFirstChild("HumanoidRootPart")
			
			if not rootPart or not humanoid or humanoid.Health <= 0 then
				task.wait(0.2)
				continue
			end
			
			rootPart.CFrame = targetRoot.CFrame * CFrame.new(0, 3, 0)
			rootPart.AssemblyLinearVelocity = Vector3.zero
			
			local isDead = false
			local diedConn = targetHum.Died:Connect(function()
				isDead = true
			end)
			
			while getgenv().TrackerActive and not isDead and targetHum.Health > 0 do
				local currentChars = LocalPlayer.Character
				local currentHums = currentChars and currentChars:FindFirstChildOfClass("Humanoid")
				local currentRoots = currentChars and currentChars:FindFirstChild("HumanoidRootPart")
				
				if not currentHums or currentHums.Health <= 0 then break end
				
				local tRoot = target.Character and target.Character:FindFirstChild("HumanoidRootPart")
				if tRoot and currentRoots then
					currentRoots.CFrame = tRoot.CFrame * CFrame.new(0, 3, 0)
					currentRoots.AssemblyLinearVelocity = Vector3.zero
				end
				RunService.Heartbeat:Wait()
			end
			
			if diedConn then diedConn:Disconnect() end
			
			local killTime = tick()
			local savedUpPosition = nil
			
			while getgenv().TrackerActive and (tick() - killTime) < 1.5 do
				local currentChars = LocalPlayer.Character
				local currentHums = currentChars and currentChars:FindFirstChildOfClass("Humanoid")
				local currentRoots = currentChars and currentChars:FindFirstChild("HumanoidRootPart")
				
				if not currentHums or currentHums.Health <= 0 then break end
				
				if currentRoots then
					if not savedUpPosition then
						savedUpPosition = currentRoots.Position + Vector3.new(0, 900, 0)
					end
					currentRoots.CFrame = CFrame.new(savedUpPosition)
					currentRoots.AssemblyLinearVelocity = Vector3.zero
					currentRoots.AssemblyAngularVelocity = Vector3.zero
				end
				RunService.Heartbeat:Wait()
			end
		else
			task.wait(0.2)
		end
	end
end)
